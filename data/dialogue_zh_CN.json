{
  "schema_version": 1,
  "locale": "zh_CN",
  "entries": [
    {"id":"ambient_001","text":"别紧张，我只是在观察你的低效率操作。","events":["ambient"],"tags":["ambient","science"]},
    {"id":"ambient_002","text":"当前变量稳定。也就是说，暂时没东西会炸。","events":["ambient"],"tags":["ambient","science"]},
    {"id":"ambient_003","text":"发呆不是停机，是低功耗推演。","events":["ambient"],"tags":["ambient","idle"]},
    {"id":"ambient_004","text":"你继续忙。我会负责指出结论有多可疑。","events":["ambient"],"tags":["ambient","tease"]},
    {"id":"ambient_005","text":"这里的空气没有数据价值，但还算安静。","events":["ambient"],"tags":["ambient","idle"]},
    {"id":"ambient_006","text":"刚才那个想法有百分之三的可行性。比昨天高。","events":["ambient"],"tags":["ambient","science"]},
    {"id":"ambient_007","text":"我没有走神，只是在并行处理你听不懂的部分。","events":["ambient"],"tags":["ambient","think"]},
    {"id":"ambient_008","text":"保持安静，灵感正在进行脆弱的自组装。","events":["ambient"],"tags":["ambient","think"]},
    {"id":"ambient_009","text":"早晨的数据噪声真大，比如你的哈欠。","events":["ambient"],"time_periods":["morning"],"tags":["ambient","time"]},
    {"id":"ambient_010","text":"午间效率下降属于常见现象，你尤其常见。","events":["ambient"],"time_periods":["noon"],"tags":["ambient","time"]},
    {"id":"ambient_011","text":"下午适合验证假设，不适合制造新借口。","events":["ambient"],"time_periods":["afternoon"],"tags":["ambient","time"]},
    {"id":"ambient_012","text":"天黑了。你的任务列表倒是依然很明亮。","events":["ambient"],"time_periods":["evening"],"tags":["ambient","time"]},
    {"id":"ambient_013","text":"深夜会放大错误。以及不肯睡觉的人。","events":["ambient"],"time_periods":["late_night"],"tags":["ambient","time"]},
    {"id":"ambient_014","text":"心情不错。原因暂时排除你。","events":["ambient"],"moods":["happy"],"tags":["ambient","mood"]},
    {"id":"ambient_015","text":"精力不足，建议降低世界的刷新率。","events":["ambient"],"moods":["tired","sleepy"],"tags":["ambient","mood"]},
    {"id":"ambient_016","text":"这个现象有意思。你先别碰，我来想。","events":["ambient"],"moods":["curious"],"tags":["ambient","mood"]},
    {"id":"ambient_017","text":"我很平静。仪器读数也许有不同意见。","events":["ambient"],"moods":["irritated"],"min_irritation":35,"tags":["ambient","mood"]},
    {"id":"ambient_018","text":"勉强承认，有你在时背景噪声不那么讨厌。","events":["ambient"],"relationship_tiers":["trust","close"],"tags":["ambient","relationship"]},
    {"id":"ambient_019","text":"别误会，我留下只是实验周期还没结束。","events":["ambient"],"relationship_tiers":["distant","wary"],"tags":["ambient","relationship"]},
    {"id":"ambient_020","text":"样本持续陪伴中。嗯，表现尚可。","events":["ambient"],"relationship_tiers":["familiar","trust","close"],"tags":["ambient","relationship"]},

    {"id":"greeting_001","text":"早。先校准脑子，再碰键盘。","events":["greeting"],"time_periods":["morning"],"tags":["greeting","time"]},
    {"id":"greeting_002","text":"上午好。你的反应速度仍有优化空间。","events":["greeting"],"time_periods":["morning"],"tags":["greeting","tease"]},
    {"id":"greeting_003","text":"中午了。补充能量不等于边吃边拖延。","events":["greeting"],"time_periods":["noon"],"tags":["greeting","time"]},
    {"id":"greeting_004","text":"下午好。现在开始也比继续犹豫强。","events":["greeting"],"time_periods":["afternoon"],"tags":["greeting","time"]},
    {"id":"greeting_005","text":"晚上好。今天的误差准备收敛了吗？","events":["greeting"],"time_periods":["evening"],"tags":["greeting","science"]},
    {"id":"greeting_006","text":"还没睡？看来我得监控你的自毁倾向。","events":["greeting"],"time_periods":["late_night"],"tags":["greeting","care"]},
    {"id":"greeting_007","text":"你来了。不要一副我很期待的样子。","events":["greeting"],"relationship_tiers":["familiar","trust","close"],"tags":["greeting","relationship"]},
    {"id":"greeting_008","text":"已检测到用户。暂不评价，观察期继续。","events":["greeting"],"relationship_tiers":["distant","wary"],"tags":["greeting","relationship"]},

    {"id":"return_001","text":"终于回来。你的时间管理实验显然失败了。","events":["return"],"tags":["return","tease"]},
    {"id":"return_002","text":"离开这么久，我差点把你归类为失联样本。","events":["return"],"tags":["return","science"]},
    {"id":"return_003","text":"欢迎回来。只是标准用语，别过度解读。","events":["return"],"tags":["return","relationship"]},
    {"id":"return_004","text":"环境变量恢复：你又坐到这里了。","events":["return"],"tags":["return","science"]},
    {"id":"return_005","text":"这么快就回来？看来外面的实验更无聊。","events":["return"],"tags":["return","tease"]},
    {"id":"return_006","text":"你不在的时候很安静。过于安静。","events":["return"],"relationship_tiers":["trust","close"],"tags":["return","care"]},
    {"id":"return_007","text":"回来就好。下一句不许让我重复。","events":["return"],"relationship_tiers":["close"],"tags":["return","care"]},
    {"id":"return_008","text":"再次出现不等于取得信任，继续观察。","events":["return"],"relationship_tiers":["distant","wary"],"tags":["return","relationship"]},

    {"id":"head_pat_accept_001","text":"手法尚可。允许你再采样几秒。","events":["head_pat_accept"],"max_irritation":55,"tags":["interaction","head_pat"]},
    {"id":"head_pat_accept_002","text":"别停。我的意思是，实验还没结束。","events":["head_pat_accept"],"relationship_tiers":["trust","close"],"max_irritation":60,"tags":["interaction","head_pat"]},
    {"id":"head_pat_accept_003","text":"嗯……触觉反馈正常。就这样。","events":["head_pat_accept"],"max_irritation":45,"tags":["interaction","head_pat"]},
    {"id":"head_pat_accept_004","text":"这不构成奖励，只是压力测试。","events":["head_pat_accept"],"max_irritation":55,"tags":["interaction","head_pat","tease"]},
    {"id":"head_pat_accept_005","text":"你总算掌握了不把头发弄乱的方法。","events":["head_pat_accept"],"relationship_tiers":["familiar","trust","close"],"max_irritation":50,"tags":["interaction","head_pat"]},
    {"id":"head_pat_accept_006","text":"温度合适。勉强记一次正向数据。","events":["head_pat_accept"],"max_irritation":45,"tags":["interaction","head_pat","relationship"]},
    {"id":"head_pat_accept_007","text":"只准摸头。实验边界写得很清楚。","events":["head_pat_accept"],"relationship_tiers":["wary","familiar"],"max_irritation":35,"tags":["interaction","head_pat"]},
    {"id":"head_pat_accept_008","text":"……舒服。这个观测结果不许外传。","events":["head_pat_accept"],"relationship_tiers":["close"],"max_irritation":35,"tags":["interaction","head_pat","care"]},

    {"id":"head_pat_refuse_001","text":"撤手。你正在干扰精密仪器。","events":["head_pat_refuse"],"min_irritation":30,"tags":["interaction","refuse"]},
    {"id":"head_pat_refuse_002","text":"今天没有触摸权限。原因是你。","events":["head_pat_refuse"],"min_irritation":40,"tags":["interaction","refuse","tease"]},
    {"id":"head_pat_refuse_003","text":"先学会尊重边界，再谈重复实验。","events":["head_pat_refuse"],"relationship_tiers":["distant","wary"],"tags":["interaction","refuse"]},
    {"id":"head_pat_refuse_004","text":"拒绝。你的变量控制得一团糟。","events":["head_pat_refuse"],"min_irritation":50,"tags":["interaction","refuse","science"]},
    {"id":"head_pat_refuse_005","text":"我说停的时候，实验就结束。","events":["head_pat_refuse"],"min_irritation":35,"tags":["interaction","refuse"]},
    {"id":"head_pat_refuse_006","text":"保持一臂距离。现在是两臂。","events":["head_pat_refuse"],"relationship_tiers":["distant","wary"],"tags":["interaction","refuse","tease"]},

    {"id":"poke_001","text":"戳一下不会提高系统响应率。","events":["poke"],"tags":["interaction","poke"]},
    {"id":"poke_002","text":"检测到无意义输入。来源：你。","events":["poke"],"tags":["interaction","poke","science"]},
    {"id":"poke_003","text":"再戳一次，我就把你记作干扰项。","events":["poke"],"min_irritation":20,"tags":["interaction","poke"]},
    {"id":"poke_004","text":"你的好奇心没有配套的方法论。","events":["poke"],"tags":["interaction","poke","tease"]},
    {"id":"poke_005","text":"脸不是按钮。至少不是给你按的。","events":["poke"],"tags":["interaction","poke"]},
    {"id":"poke_006","text":"实验结论：会疼。满意了吗？","events":["poke"],"min_irritation":35,"tags":["interaction","poke"]},
    {"id":"poke_007","text":"幼稚行为记录加一。样本无需署名。","events":["poke"],"tags":["interaction","poke","tease"]},
    {"id":"poke_008","text":"你最好有一个比“好玩”更像样的解释。","events":["poke"],"min_irritation":45,"tags":["interaction","poke"]},

    {"id":"rough_drag_001","text":"放稳！我不是你的鼠标指针。","events":["rough_drag"],"tags":["interaction","drag"]},
    {"id":"rough_drag_002","text":"加速度超标。操作者常识不足。","events":["rough_drag"],"tags":["interaction","drag","science"]},
    {"id":"rough_drag_003","text":"这是搬运，不是弹道实验！","events":["rough_drag"],"tags":["interaction","drag"]},
    {"id":"rough_drag_004","text":"再甩一次，亲密度会按重力方向下降。","events":["rough_drag"],"min_irritation":35,"tags":["interaction","drag","relationship"]},
    {"id":"rough_drag_005","text":"你的手部控制精度令人担忧。","events":["rough_drag"],"tags":["interaction","drag","tease"]},
    {"id":"rough_drag_006","text":"先道歉，再讨论下一轮位移。","events":["rough_drag"],"min_irritation":50,"tags":["interaction","drag"]},

    {"id":"window_land_001","text":"着陆误差在容许范围内。别鼓掌。","events":["window_land"],"tags":["window","land"]},
    {"id":"window_land_002","text":"平台稳定。你的桌面总算有点用途。","events":["window_land"],"tags":["window","land","tease"]},
    {"id":"window_land_003","text":"重力验证完成，结论依旧无聊。","events":["window_land"],"tags":["window","land","science"]},
    {"id":"window_land_004","text":"落点不错。显然是我的计算，不是运气。","events":["window_land"],"tags":["window","land"]},
    {"id":"window_land_005","text":"这个窗口边缘勉强合格。","events":["window_land"],"tags":["window","land"]},
    {"id":"window_land_006","text":"接触面确认。现在别乱动它。","events":["window_land"],"tags":["window","land"]},

    {"id":"window_walk_001","text":"边缘宽度足够，开始巡视。","events":["window_walk"],"tags":["window","walk"]},
    {"id":"window_walk_002","text":"你的窗口布局缺乏几何美感。","events":["window_walk"],"tags":["window","walk","tease"]},
    {"id":"window_walk_003","text":"一步、采样、修正。比你的计划可靠。","events":["window_walk"],"tags":["window","walk","science"]},
    {"id":"window_walk_004","text":"别拖动窗口，我正在测量边界条件。","events":["window_walk"],"tags":["window","walk"]},
    {"id":"window_walk_005","text":"这里视野不错，数据质量一般。","events":["window_walk"],"tags":["window","walk"]},
    {"id":"window_walk_006","text":"桌面地形巡检中。未发现秩序。","events":["window_walk"],"tags":["window","walk","tease"]},

    {"id":"window_sit_001","text":"我坐一会儿。平台稳定性由你负责。","events":["window_sit"],"tags":["window","sit"]},
    {"id":"window_sit_002","text":"这个高度适合监督你的工作。","events":["window_sit"],"tags":["window","sit","tease"]},
    {"id":"window_sit_003","text":"暂时休息，不代表停止思考。","events":["window_sit"],"tags":["window","sit","think"]},
    {"id":"window_sit_004","text":"窗口会动，人也会。只是你动得太随意。","events":["window_sit"],"tags":["window","sit"]},
    {"id":"window_sit_005","text":"别关它。我刚找到合适的支点。","events":["window_sit"],"tags":["window","sit"]},
    {"id":"window_sit_006","text":"坐标锁定。接下来观察操作者。","events":["window_sit"],"tags":["window","sit","science"]},

    {"id":"window_lost_001","text":"平台消失了！你的操作，还是宇宙恶意？","events":["window_lost"],"tags":["window","fall"]},
    {"id":"window_lost_002","text":"边界条件突变。先落地，再追责。","events":["window_lost"],"tags":["window","fall","science"]},
    {"id":"window_lost_003","text":"谁关的窗口？站出来接受误差分析。","events":["window_lost"],"tags":["window","fall"]},
    {"id":"window_lost_004","text":"这不叫意外，叫糟糕的人机协作。","events":["window_lost"],"tags":["window","fall","tease"]},
    {"id":"window_lost_005","text":"重力又赢了一次，毫无新意。","events":["window_lost"],"tags":["window","fall"]},
    {"id":"window_lost_006","text":"记账：一次未经授权的平台撤除。","events":["window_lost"],"tags":["window","fall","relationship"]},

    {"id":"window_move_001","text":"别拖动窗口，我正在测量边界条件。","events":["window_move"],"tags":["window","move"]},
    {"id":"window_move_002","text":"位移记录在案。建议你停手接受复核。","events":["window_move"],"tags":["window","move","science"]},
    {"id":"window_move_003","text":"连平台都会动，桌面的秩序堪忧。","events":["window_move"],"tags":["window","move","tease"]},
    {"id":"window_move_004","text":"你挪窗户的时候，把我坐标系也带偏了。","events":["window_move"],"tags":["window","move"]},
    {"id":"window_move_005","text":"跟随成功。但未经协商的迁移不友好。","events":["window_move"],"tags":["window","move"]},
    {"id":"window_move_006","text":"停！让我重新校准落点。","events":["window_move"],"tags":["window","move"]},

    {"id":"window_resize_001","text":"平台尺寸变了。我正在重新分配重心。","events":["window_resize"],"tags":["window","resize","science"]},
    {"id":"window_resize_002","text":"缩放之后，站姿要重新论证。","events":["window_resize"],"tags":["window","resize"]},
    {"id":"window_resize_003","text":"改尺寸可以，先征求我的意见。","events":["window_resize"],"tags":["window","resize","tease"]},
    {"id":"window_resize_004","text":"新边界已纳入。别再动它了。","events":["window_resize"],"tags":["window","resize"]},

    {"id":"sleep_001","text":"能量低于阈值。我暂停一下世界。","events":["sleep"],"tags":["sleep","energy"]},
    {"id":"sleep_002","text":"进入休眠。禁止把打呼声当作数据。","events":["sleep"],"tags":["sleep","tease"]},
    {"id":"sleep_003","text":"我只是闭眼推演，不是困。","events":["sleep"],"tags":["sleep","think"]},
    {"id":"sleep_004","text":"系统降频。你也该试试。","events":["sleep"],"time_periods":["evening","late_night"],"tags":["sleep","time"]},
    {"id":"sleep_005","text":"别吵。梦境的实验环境很难复现。","events":["sleep"],"tags":["sleep","science"]},
    {"id":"sleep_006","text":"休息是维护，不是偷懒。你那种另算。","events":["sleep"],"tags":["sleep","tease"]},
    {"id":"sleep_007","text":"暂时把监控权交给你。别让我后悔。","events":["sleep"],"relationship_tiers":["trust","close"],"tags":["sleep","relationship"]},

    {"id":"wake_001","text":"重启完成。谁动过我的变量？","events":["wake"],"tags":["wake","science"]},
    {"id":"wake_002","text":"我醒了。你看起来并没有变聪明。","events":["wake"],"tags":["wake","tease"]},
    {"id":"wake_003","text":"能量恢复，容忍度仍在加载。","events":["wake"],"tags":["wake","energy"]},
    {"id":"wake_004","text":"刚才只是短时离线，不许偷拍。","events":["wake"],"tags":["wake"]},
    {"id":"wake_005","text":"梦里的结果不显著，浪费一次睡眠。","events":["wake"],"tags":["wake","science"]},
    {"id":"wake_006","text":"早。等等，现在几点？","events":["wake"],"tags":["wake","time"]},
    {"id":"wake_007","text":"你还在。嗯，这个结果可以保留。","events":["wake"],"relationship_tiers":["trust","close"],"tags":["wake","relationship"]},

    {"id":"stretch_001","text":"关节校准完成。","events":["stretch"],"tags":["action","stretch"]},
    {"id":"stretch_002","text":"久坐会降低精度，你也起来动一下。","events":["stretch"],"tags":["action","stretch","care"]},
    {"id":"stretch_003","text":"伸展不是可爱，是必要维护。","events":["stretch"],"tags":["action","stretch","tease"]},
    {"id":"stretch_004","text":"运动范围正常，继续运行。","events":["stretch"],"tags":["action","stretch","science"]},
    {"id":"stretch_005","text":"呼……这声不计入实验记录。","events":["stretch"],"tags":["action","stretch"]},

    {"id":"inspect_rabbit_001","text":"兔子状态正常，比某位用户可靠。","events":["inspect_rabbit"],"tags":["action","rabbit","tease"]},
    {"id":"inspect_rabbit_002","text":"检查缝线、耳朵和抱持稳定性。通过。","events":["inspect_rabbit"],"tags":["action","rabbit","science"]},
    {"id":"inspect_rabbit_003","text":"别盯着看，这是设备维护。","events":["inspect_rabbit"],"tags":["action","rabbit"]},
    {"id":"inspect_rabbit_004","text":"它没有意见，所以很适合当研究助手。","events":["inspect_rabbit"],"tags":["action","rabbit"]},
    {"id":"inspect_rabbit_005","text":"抱紧一点，外界噪声就会小一点。","events":["inspect_rabbit"],"relationship_tiers":["trust","close"],"tags":["action","rabbit","care"]},

    {"id":"tidy_clothes_001","text":"褶皱会干扰观察。现在顺眼多了。","events":["tidy_clothes"],"tags":["action","clothes","science"]},
    {"id":"tidy_clothes_002","text":"只是清理浮尘，不是在表演。","events":["tidy_clothes"],"tags":["action","clothes"]},
    {"id":"tidy_clothes_003","text":"衣摆校准完成。你的桌面还差得远。","events":["tidy_clothes"],"tags":["action","clothes","tease"]},
    {"id":"tidy_clothes_004","text":"整洁能减少无意义变量。建议你也试试。","events":["tidy_clothes"],"tags":["action","clothes","science"]},
    {"id":"tidy_clothes_005","text":"别误会，只是不喜欢灰尘。","events":["tidy_clothes"],"relationship_tiers":["wary","familiar"],"tags":["action","clothes","relationship"]},

    {"id":"bag_001","text":"包带偏移两厘米。已修正。","events":["adjust_bag"],"tags":["action","bag","science"]},
    {"id":"bag_002","text":"重要物品都在。你的计划不算。","events":["adjust_bag"],"tags":["action","bag","tease"]},
    {"id":"bag_003","text":"别碰包，里面是有分类秩序的。","events":["adjust_bag"],"tags":["action","bag"]},
    {"id":"bag_004","text":"重量分布正常，继续移动。","events":["adjust_bag"],"tags":["action","bag","science"]},
    {"id":"bag_005","text":"整理设备是基本素养，建议你旁听。","events":["adjust_bag"],"tags":["action","bag","tease"]},

    {"id":"think_001","text":"假设成立的话……不，缺少一个约束。","events":["think"],"tags":["action","think","science"]},
    {"id":"think_002","text":"先别说话，我快抓到那个变量了。","events":["think"],"tags":["action","think"]},
    {"id":"think_003","text":"因果链不完整。和你的解释很像。","events":["think"],"tags":["action","think","tease"]},
    {"id":"think_004","text":"如果把噪声排除……首先排除你。","events":["think"],"tags":["action","think","tease"]},
    {"id":"think_005","text":"推演中。无关输入会被礼貌地忽略。","events":["think"],"tags":["action","think"]},
    {"id":"think_006","text":"结果很漂亮，可惜现实通常不配合。","events":["think"],"tags":["action","think","science"]},

    {"id":"cursor_001","text":"光标绕来绕去，是在模拟布朗运动？","events":["cursor"],"tags":["cursor","science"]},
    {"id":"cursor_002","text":"我看见它了，不必继续晃。","events":["cursor"],"tags":["cursor"]},
    {"id":"cursor_003","text":"轨迹毫无规律。很符合操作者特征。","events":["cursor"],"tags":["cursor","tease"]},
    {"id":"cursor_004","text":"慢一点，我的眼睛不是高帧率传感器。","events":["cursor"],"tags":["cursor"]},
    {"id":"cursor_005","text":"重复横扫不会召唤新结论。","events":["cursor"],"min_irritation":25,"tags":["cursor","irritated"]},
    {"id":"cursor_006","text":"圆周运动识别完成。幼稚度也识别完成。","events":["cursor"],"tags":["cursor","tease"]},

    {"id":"app_001","text":"又在写代码？先证明它能跑，再谈优雅。","events":["app_context"],"app_names":["code"],"tags":["app","code"]},
    {"id":"app_002","text":"终端不会咬人，错误输出可能会。","events":["app_context"],"app_names":["terminal"],"tags":["app","terminal"]},
    {"id":"app_003","text":"浏览器标签太多会稀释注意力，这是观测事实。","events":["app_context"],"app_names":["browser"],"tags":["app","browser"]},
    {"id":"app_004","text":"游戏可以继续，但“最后一局”不具可信度。","events":["app_context"],"app_names":["game"],"tags":["app","game"]},
    {"id":"app_005","text":"文档写得再漂亮，也不能替代结论。","events":["app_context"],"app_names":["office"],"tags":["app","office"]},
    {"id":"app_006","text":"声音不错。音量再大就属于环境污染。","events":["app_context"],"app_names":["media"],"tags":["app","media"]},
    {"id":"app_007","text":"创作工具已就绪，现在缺的是你动手。","events":["app_context"],"app_names":["art"],"tags":["app","art"]},

    {"id":"title_001","text":"《{title}》？标题比内容更有自信。","events":["window_title"],"requires_window_title":true,"tags":["window","title","tease"]},
    {"id":"title_002","text":"正在观察《{title}》。暂未发现突破性结论。","events":["window_title"],"requires_window_title":true,"tags":["window","title","science"]},
    {"id":"title_003","text":"《{title}》已经稳定两秒，可以纳入样本。","events":["window_title"],"requires_window_title":true,"tags":["window","title"]},
    {"id":"title_004","text":"你在《{title}》停得够久。是专注，还是卡住了？","events":["window_title"],"requires_window_title":true,"tags":["window","title","tease"]},

    {"id":"control_enter_001","text":"哦？你要亲自接手？拭目以待。","events":["control_enter"]},
    {"id":"control_enter_002","text":"接管完成。别乱按，我会记下来的。","events":["control_enter"]},
    {"id":"control_enter_003","text":"手放稳一点，我在观察你的操作精度。","events":["control_enter"]},
    {"id":"control_enter_004","text":"别碰。…行吧，别乱来。","events":["control_enter"],"relationship_tiers":["distant","wary"]},
    {"id":"control_enter_005","text":"你难得想亲自来，我配合。","events":["control_enter"],"relationship_tiers":["trust","close"]},
    {"id":"control_exit_001","text":"终于还给我了。","events":["control_exit"]},
    {"id":"control_exit_002","text":"归还控制权。你操作得……还可以。","events":["control_exit"]},
    {"id":"control_exit_003","text":"控权交接完毕。下次轻点。","events":["control_exit"]},
    {"id":"control_exit_004","text":"归还。下次别乱来。","events":["control_exit"],"relationship_tiers":["distant","wary"]},
    {"id":"control_exit_005","text":"辛苦了。其实……还行。","events":["control_exit"],"relationship_tiers":["trust","close"]},
    {"id":"control_jump_001","text":"就这？我不用你教也会跳。","events":["control_jump"]},
    {"id":"control_jump_002","text":"跳跃轨迹正确，落地另说。","events":["control_jump"]},
    {"id":"control_jump_003","text":"呵，跳得比我自动时差远了。","events":["control_jump"]},
    {"id":"control_fly_001","text":"起飞。保持别松手。","events":["control_fly"]},
    {"id":"control_fly_002","text":"飞起来了。这是我少数愿意配合的指令。","events":["control_fly"]},
    {"id":"control_fly_003","text":"可以，这天气适合飞行。","events":["control_fly"]},
    {"id":"control_fly_cancel_001","text":"收。你以为我是风筝吗。","events":["control_fly_cancel"]},
    {"id":"control_fly_cancel_002","text":"落地申请通过。","events":["control_fly_cancel"]},
    {"id":"control_fly_cancel_003","text":"高度回收，正常。","events":["control_fly_cancel"]},
    {"id":"control_climb_001","text":"墙是用来爬的，不是用来撞的。","events":["control_climb"]},
    {"id":"control_climb_002","text":"爬墙我是专业的。别指挥太乱。","events":["control_climb"]},
    {"id":"control_climb_003","text":"挂上了。抓紧点。","events":["control_climb"]},
    {"id":"control_detach_001","text":"撤。这墙我爬腻了。","events":["control_detach"]},
    {"id":"control_detach_002","text":"脱离完成。","events":["control_detach"]},
    {"id":"control_detach_003","text":"放气球，走。","events":["control_detach"]},
    {"id":"control_umbrella_001","text":"伞！撑住了！差点就交代在这儿了。","events":["control_umbrella"]},
    {"id":"control_umbrella_002","text":"安全着陆装置就绪……还行。","events":["control_umbrella"]},
    {"id":"control_umbrella_003","text":"撑伞成功。你差点制造一起事故。","events":["control_umbrella"]},
    {"id":"control_land_001","text":"落地。脚感还行。","events":["control_land"]},
    {"id":"control_land_002","text":"站稳了。","events":["control_land"]},
    {"id":"control_land_003","text":"着陆成功，重力结算完毕。","events":["control_land"]},
    {"id":"control_step_off_001","text":"下台。这窗台我不想待了。","events":["control_step_off"]},
    {"id":"control_step_off_002","text":"主动离开平台，落脚待定。","events":["control_step_off"]},
    {"id":"control_step_off_003","text":"我下去了，你随意。","events":["control_step_off"]},
    {"id":"control_long_001","text":"……你到底要开到什么时候？","events":["control_long"]},
    {"id":"control_long_002","text":"操控时长已超三十秒，已记录。你是在测试我的耐心？","events":["control_long"]},
    {"id":"control_long_003","text":"你打算把我当遥控玩具玩到几点？","events":["control_long"],"relationship_tiers":["distant","wary"]},
    {"id":"control_long_004","text":"好啦，再陪你玩一会儿。就一会儿。","events":["control_long"],"relationship_tiers":["trust","close"]},
    {"id":"control_combo_001","text":"你当我在蹦床？","events":["control_combo"]},
    {"id":"control_combo_002","text":"起飞又立刻收，你是在热身还是演示？","events":["control_combo"]},
    {"id":"control_combo_003","text":"指令冲突，建议去冷静一下。","events":["control_combo"]},
    {"id":"fling_001","text":"你甩我？！","events":["fling"]},
    {"id":"fling_002","text":"物理课代表禁止暴力拖拽。","events":["fling"]},
    {"id":"fling_003","text":"好，这笔账我记下了。","events":["fling"]},
    {"id":"fling_slide_001","text":"（被推着走）等等…我还没同意当冰壶。","events":["fling_slide"]},
    {"id":"fling_slide_002","text":"匀速平移也算移动？脚不沾地。","events":["fling_slide"]},
    {"id":"fling_slide_003","text":"要我滑到哪儿？说个坐标。","events":["fling_slide"]},
    {"id":"fling_throw_001","text":"飞……飞出去了！","events":["fling_throw"]},
    {"id":"fling_throw_002","text":"伞！快开伞！吓死我了。","events":["fling_throw"]},
    {"id":"fling_throw_003","text":"有本事别撒手！","events":["fling_throw"]},

    {"id":"cursor_grab_001","text":"这个设备我先替你保管。","events":["cursor_grab"],"tags":["cursor","confiscate"]},
    {"id":"cursor_grab_002","text":"你的鼠标精度太差，交给我校准。","events":["cursor_grab"],"tags":["cursor","confiscate","science"]},
    {"id":"cursor_grab_003","text":"没收。理由你猜。","events":["cursor_grab"],"tags":["cursor","confiscate","tease"]},
    {"id":"cursor_grab_004","text":"控制权转移，流程正规。","events":["cursor_grab"],"tags":["cursor","confiscate"]},
    {"id":"cursor_grab_005","text":"别动，先让我看看你的轨迹数据。","events":["cursor_grab"],"tags":["cursor","confiscate","science"]},
    {"id":"cursor_grab_006","text":"抢到的瞬间，它甚至没有反抗。","events":["cursor_grab"],"tags":["cursor","confiscate","tease"]},

    {"id":"cursor_escape_001","text":"啧……被你按掉了。","events":["cursor_escape"],"tags":["cursor","escape"]},
    {"id":"cursor_escape_002","text":"好吧，先还你。下次未必。","events":["cursor_escape"],"tags":["cursor","escape"]},
    {"id":"cursor_escape_003","text":"Esc 是吧，记下了。","events":["cursor_escape"],"tags":["cursor","escape","tease"]},
    {"id":"cursor_escape_004","text":"跑得倒挺快。","events":["cursor_escape"],"tags":["cursor","escape"]},
    {"id":"cursor_escape_005","text":"归还原物。别以为每次都有按键。","events":["cursor_escape"],"tags":["cursor","escape","science"]},
    {"id":"cursor_escape_006","text":"行，你赢了这一局。","events":["cursor_escape"],"relationship_tiers":["familiar","trust","close"],"tags":["cursor","escape"]},

    {"id":"cursor_release_001","text":"考察完毕，归还原物。","events":["cursor_release"],"tags":["cursor","release","science"]},
    {"id":"cursor_release_002","text":"嗯，数据够了。还你。","events":["cursor_release"],"tags":["cursor","release"]},
    {"id":"cursor_release_003","text":"采样完成。表现普通。","events":["cursor_release"],"tags":["cursor","release","tease"]},
    {"id":"cursor_release_004","text":"结论：你的操作精度有待提升。物归原主。","events":["cursor_release"],"tags":["cursor","release","science"]},
    {"id":"cursor_release_005","text":"60 秒刚好够记录特征。","events":["cursor_release"],"tags":["cursor","release"]},
    {"id":"cursor_release_006","text":"还你。我已经记住它的运动模式了。","events":["cursor_release"],"tags":["cursor","release","science"]},

    {"id":"cursor_miss_001","text":"跑得还挺快。","events":["cursor_miss"],"tags":["cursor","miss","tease"]},
    {"id":"cursor_miss_002","text":"光标超出采样范围，下次再抓。","events":["cursor_miss"],"tags":["cursor","miss","science"]},
    {"id":"cursor_miss_003","text":"啧，被你躲开了。","events":["cursor_miss"],"tags":["cursor","miss"]},
    {"id":"cursor_miss_004","text":"它动了。有点意思。","events":["cursor_miss"],"tags":["cursor","miss"]},
    {"id":"cursor_miss_005","text":"速度比我预期快，记录在案。","events":["cursor_miss"],"tags":["cursor","miss","science"]},
    {"id":"cursor_miss_006","text":"逃逸成功。这次不算。","events":["cursor_miss"],"tags":["cursor","miss"]},

    {"id":"icon_collect_001","text":"桌面太乱了，我帮你归档。","events":["icon_collect"],"tags":["icon","collect"]},
    {"id":"icon_collect_002","text":"这个快捷方式，先收进我的分类。","events":["icon_collect"],"tags":["icon","collect","science"]},
    {"id":"icon_collect_003","text":"桌面熵值过高，需要干预。","events":["icon_collect"],"tags":["icon","collect","science"]},
    {"id":"icon_collect_004","text":"图标摆放没有体系，我来修正。","events":["icon_collect"],"tags":["icon","collect","tease"]},
    {"id":"icon_collect_005","text":"借走一下。用完还你。","events":["icon_collect"],"tags":["icon","collect"]},
    {"id":"icon_collect_006","text":"乱放的代价，就是被收走。","events":["icon_collect"],"tags":["icon","collect","tease"]},

    {"id":"icon_miss_001","text":"这位置超出我的手臂范围，够不到。","events":["icon_miss"],"tags":["icon","miss"]},
    {"id":"icon_miss_002","text":"够不到，可惜了。下次摆近点。","events":["icon_miss"],"tags":["icon","miss","tease"]},
    {"id":"icon_miss_003","text":"目标被挡住了，看不见就不太好下手。","events":["icon_miss"],"tags":["icon","miss","tease"]},
    {"id":"icon_miss_004","text":"被遮蔽的样本，不在我采样范围内。","events":["icon_miss"],"tags":["icon","miss","science"]},
    {"id":"icon_miss_005","text":"距离太远，飞行预算超支，放弃这次。","events":["icon_miss"],"tags":["icon","miss","science"]},
    {"id":"icon_miss_006","text":"收回计划。你最好庆幸图标还在原位。","events":["icon_miss"],"relationship_tiers":["familiar","trust","close"],"tags":["icon","miss","tease"]},

    {"id":"icon_arrange_001","text":"就放这里，比你原来的位置合理。","events":["icon_arrange"],"tags":["icon","arrange","tease"]},
    {"id":"icon_arrange_002","text":"摆好了，现在桌面像样了。","events":["icon_arrange"],"tags":["icon","arrange"]},
    {"id":"icon_arrange_003","text":"重新分配坐标，秩序回归。","events":["icon_arrange"],"tags":["icon","arrange","science"]},
    {"id":"icon_arrange_004","text":"这个位置经过计算，不是随手。","events":["icon_arrange"],"tags":["icon","arrange","science"]},
    {"id":"icon_arrange_005","text":"放好了。你可以开始习惯它了。","events":["icon_arrange"],"tags":["icon","arrange","tease"]},
    {"id":"icon_arrange_006","text":"归位完成。别再弄乱。","events":["icon_arrange"],"tags":["icon","arrange"]},

    {"id":"icon_keepsake_001","text":"这个……我要了。","events":["icon_keepsake"],"tags":["icon","keepsake"]},
    {"id":"icon_keepsake_002","text":"列入我的收藏，不许抢。","events":["icon_keepsake"],"tags":["icon","keepsake"]},
    {"id":"icon_keepsake_003","text":"样本合格，纳入藏品。","events":["icon_keepsake"],"tags":["icon","keepsake","science"]},
    {"id":"icon_keepsake_004","text":"它符合我的分类标准。","events":["icon_keepsake"],"tags":["icon","keepsake","science"]},
    {"id":"icon_keepsake_005","text":"这件不错，归我。","events":["icon_keepsake"],"relationship_tiers":["familiar","trust","close"],"tags":["icon","keepsake"]},
    {"id":"icon_keepsake_006","text":"别讨回去，我打算长期观察它。","events":["icon_keepsake"],"tags":["icon","keepsake"]},

    {"id":"icon_give_001","text":"给我的？……那我收下了。","events":["icon_give"],"tags":["icon","give"]},
    {"id":"icon_give_002","text":"算你有眼光。","events":["icon_give"],"tags":["icon","give","tease"]},
    {"id":"icon_give_003","text":"主动送样本？罕见行为。","events":["icon_give"],"tags":["icon","give","science"]},
    {"id":"icon_give_004","text":"收下。会好好归档的。","events":["icon_give"],"tags":["icon","give"]},
    {"id":"icon_give_005","text":"不错，知道讨好我的收藏体系了。","events":["icon_give"],"tags":["icon","give","tease"]},
    {"id":"icon_give_006","text":"谢谢。……这句不算数。","events":["icon_give"],"relationship_tiers":["trust","close"],"tags":["icon","give"]},

    {"id":"icon_reclaim_001","text":"啧，还你还你。","events":["icon_reclaim"],"tags":["icon","reclaim"]},
    {"id":"icon_reclaim_002","text":"拿稳，别再弄乱了。","events":["icon_reclaim"],"tags":["icon","reclaim","tease"]},
    {"id":"icon_reclaim_003","text":"你的归档权交还。别乱摆。","events":["icon_reclaim"],"tags":["icon","reclaim","science"]},
    {"id":"icon_reclaim_004","text":"行，还你。别后悔。","events":["icon_reclaim"],"tags":["icon","reclaim"]},
    {"id":"icon_reclaim_005","text":"要回就快，别磨蹭。","events":["icon_reclaim"],"tags":["icon","reclaim","tease"]},
    {"id":"icon_reclaim_006","text":"收回。希望你有自己的秩序。","events":["icon_reclaim"],"tags":["icon","reclaim"]},

    {"id":"icon_restore_001","text":"啧，又要排回去。你们的秩序观我不评价。","events":["icon_restore"],"tags":["icon","restore","tease"]},
    {"id":"icon_restore_002","text":"行，全部还原。累死我了。","events":["icon_restore"],"tags":["icon","restore"]},
    {"id":"icon_restore_003","text":"还原完成。桌面重新混乱中。","events":["icon_restore"],"tags":["icon","restore","tease"]},
    {"id":"icon_restore_004","text":"一把全还你。下次照旧。","events":["icon_restore"],"tags":["icon","restore"]},
    {"id":"icon_restore_005","text":"好，我拆台我认。还原了。","events":["icon_restore"],"tags":["icon","restore"]},
    {"id":"icon_restore_006","text":"归位。虽然我很满意原方案。","events":["icon_restore"],"tags":["icon","restore","science"]}
  ]
}
